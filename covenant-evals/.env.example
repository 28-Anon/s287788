# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required by SEC EDGAR. A missing or generic User-Agent returns 403 and a ~10 minute
# IP block. Format: your name and a contact email.
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Required once you start making API calls (week 8 onwards, not week 1).
ANTHROPIC_API_KEY="sk-ant-..."
